<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dual-target build. One source tree, two compile targets:
      net9.0  -> Jellyfin 10.11 line (.NET 9 plugin ABI)
      net10.0 -> Jellyfin 12 line    (.NET 10 plugin ABI)
    Jellyfin ships a new assembly identity per server generation
    (MediaBrowser.Controller 10.11.11.0 vs 12.0.0.0) and changes a handful of
    interface members, so one DLL cannot serve both. Everything except the
    seams guarded by the JELLYFIN_12 symbol compiles identically for both.

    Set NebulaBridgeTargetFramework to collapse to a single target (used by the
    compatibility spike workflow and by the release jobs, which package one
    target at a time).
  -->
  <PropertyGroup Condition="'$(NebulaBridgeTargetFramework)' != ''">
    <TargetFramework>$(NebulaBridgeTargetFramework)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NebulaBridgeTargetFramework)' == ''">
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NebulaBridge</AssemblyName>
    <Version>0.4.2.1</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!--
    Per-target Jellyfin package line. An explicit -p:JellyfinVersion still wins,
    so a single-target spike can pin any package version it likes.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_12</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinVersion)' == ''">
    <JellyfinVersion>10.11.11</JellyfinVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NebulaBridge.Tests" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)" />
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="AngleSharp.XPath" Version="2.0.6" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reflection.TypeExtensions" Version="4.7.0" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="NebulaBridge.Tests\**\*.cs" />
    <!-- Experimental provider projects compile independently and must not enter the plugin glob. -->
    <Compile Remove="OxImplementationCandidate\**\*.cs" />
    <EmbeddedResource Include="Config\config.html" />
    <EmbeddedResource Include="Config\config.js" />
    <EmbeddedResource Include="Assets\nebula-library-cover.png" />
    <EmbeddedResource Include="indexers\schema.json" />
    <!-- Embed all frontend assets so they are delivered with the plugin -->
    <EmbeddedResource Include="Frontend\**\*" />
  </ItemGroup>
  <Target Name="CleanupJellyfinDlls" AfterTargets="Build">
    <ItemGroup>
      <AllDlls Include="$(OutDir)*.dll" />
      <FilesToKeep
        Include="&#xA;        $(OutDir)NebulaBridge.dll;&#xA;        $(OutDir)JellyfinLoaderStub*.dll;&#xA;        $(OutDir)0Harmony.dll;&#xA;        $(OutDir)AngleSharp.dll;&#xA;        $(OutDir)AngleSharp.XPath.dll;&#xA;        $(OutDir)JsonSchema.Net.dll;&#xA;        $(OutDir)JsonPointer.Net.dll;&#xA;        $(OutDir)Json.More.dll;&#xA;        $(OutDir)Humanizer.dll;&#xA;        $(OutDir)YamlDotNet.dll;&#xA;        $(OutDir)QrCodeGenerator.dll"
      />
      <FilesToDelete Include="@(AllDlls)" Exclude="@(FilesToKeep)" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>
</Project>
